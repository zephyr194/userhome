{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UserHome",
  "version": "0.1.0",
  "identifier": "com.zephyr194.userhome",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "helper/dist/UserHomeHelper": "UserHomeHelper",
      "helper/dist/libUserHomeHelperBridge.dylib": "libUserHomeHelperBridge.dylib"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchDaemons/com.zephyr194.userhome.helper.plist": "helper/LaunchDaemons/com.zephyr194.userhome.helper.plist"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
