{
  "schemaVersion": 1,
  "apps": [
    {
      "id": "github-copilot",
      "displayName": "GitHub Copilot",
      "description": "管理 Copilot CLI 的用户级 JSON 配置与指令文件。",
      "iconKey": "copilot",
      "detectionRules": [
        { "kind": "HOME_PATH", "value": "~/.copilot" },
        { "kind": "EXECUTABLE", "value": "copilot" }
      ],
      "executables": ["copilot"],
      "brewFormulae": [],
      "brewCasks": [],
      "configDocuments": [
        {
          "configId": "copilot-config",
          "pathTemplate": "~/.copilot/config.json",
          "format": "JSON",
          "sensitivity": "SENSITIVE",
          "adapterId": "copilot-json",
          "validatorId": "json",
          "maxSizeBytes": 262144,
          "writePolicy": "STRUCTURED_AND_RAW"
        },
        {
          "configId": "copilot-settings",
          "pathTemplate": "~/.copilot/settings.json",
          "format": "JSON",
          "sensitivity": "SENSITIVE",
          "adapterId": "copilot-json",
          "validatorId": "json",
          "maxSizeBytes": 262144,
          "writePolicy": "STRUCTURED_AND_RAW"
        },
        {
          "configId": "copilot-mcp-config",
          "pathTemplate": "~/.copilot/mcp-config.json",
          "format": "JSON",
          "sensitivity": "SECRET",
          "adapterId": "copilot-json",
          "validatorId": "json",
          "maxSizeBytes": 262144,
          "writePolicy": "STRUCTURED_AND_RAW"
        },
        {
          "configId": "copilot-permissions-config",
          "pathTemplate": "~/.copilot/permissions-config.json",
          "format": "JSON",
          "sensitivity": "SENSITIVE",
          "adapterId": "copilot-json",
          "validatorId": "json",
          "maxSizeBytes": 262144,
          "writePolicy": "STRUCTURED_AND_RAW"
        },
        {
          "configId": "copilot-instructions",
          "pathTemplate": "~/.copilot/copilot-instructions.md",
          "format": "MARKDOWN",
          "sensitivity": "SENSITIVE",
          "adapterId": "copilot-instructions",
          "validatorId": "markdown",
          "maxSizeBytes": 262144,
          "writePolicy": "STRUCTURED_AND_RAW"
        }
      ],
      "services": [],
      "capabilities": ["DETECT", "READ_CONFIG", "WRITE_CONFIG"]
    },
    {
      "id": "caddy",
      "displayName": "Caddy",
      "description": "管理 Homebrew 安装的 Caddy 配置与用户级服务。",
      "iconKey": "caddy",
      "detectionRules": [
        { "kind": "EXECUTABLE", "value": "caddy" },
        { "kind": "BREW_FORMULA", "value": "caddy" },
        { "kind": "SERVICE", "value": "caddy" },
        {
          "kind": "HOMEBREW_PATH",
          "value": "${HOMEBREW_PREFIX}/etc/Caddyfile"
        }
      ],
      "executables": ["caddy"],
      "brewFormulae": ["caddy"],
      "brewCasks": [],
      "configDocuments": [
        {
          "configId": "caddyfile",
          "pathTemplate": "${HOMEBREW_PREFIX}/etc/Caddyfile",
          "format": "CADDYFILE",
          "sensitivity": "STANDARD",
          "adapterId": "caddyfile",
          "validatorId": "caddy",
          "maxSizeBytes": 1048576,
          "writePolicy": "STRUCTURED_AND_RAW",
          "elevationResourceId": "caddy:system-caddyfile"
        }
      ],
      "services": ["caddy"],
      "capabilities": [
        "DETECT",
        "READ_CONFIG",
        "WRITE_CONFIG",
        "MANAGE_SERVICE"
      ]
    },
    {
      "id": "git",
      "displayName": "Git",
      "description": "管理 Git 全局身份、默认分支、别名和安全设置。",
      "iconKey": "git",
      "detectionRules": [
        { "kind": "EXECUTABLE", "value": "git" },
        { "kind": "BREW_FORMULA", "value": "git" },
        { "kind": "HOME_PATH", "value": "~/.gitconfig" }
      ],
      "executables": ["git"],
      "brewFormulae": ["git"],
      "brewCasks": [],
      "configDocuments": [
        {
          "configId": "git-global-config",
          "pathTemplate": "~/.gitconfig",
          "format": "GIT_CONFIG",
          "sensitivity": "SENSITIVE",
          "adapterId": "git-config",
          "validatorId": "git-config",
          "maxSizeBytes": 524288,
          "writePolicy": "STRUCTURED_AND_RAW"
        }
      ],
      "services": [],
      "capabilities": ["DETECT", "READ_CONFIG", "WRITE_CONFIG"]
    },
    {
      "id": "openssh",
      "displayName": "OpenSSH",
      "description": "管理 SSH 客户端 Host 配置，不读取任何私钥内容。",
      "iconKey": "openssh",
      "detectionRules": [
        { "kind": "EXECUTABLE", "value": "ssh" },
        { "kind": "BREW_FORMULA", "value": "openssh" },
        { "kind": "HOME_PATH", "value": "~/.ssh/config" }
      ],
      "executables": ["ssh"],
      "brewFormulae": ["openssh"],
      "brewCasks": [],
      "configDocuments": [
        {
          "configId": "ssh-client-config",
          "pathTemplate": "~/.ssh/config",
          "format": "SSH_CONFIG",
          "sensitivity": "SENSITIVE",
          "adapterId": "ssh-config",
          "validatorId": "ssh-config",
          "maxSizeBytes": 524288,
          "writePolicy": "STRUCTURED_AND_RAW"
        }
      ],
      "services": [],
      "capabilities": ["DETECT", "READ_CONFIG", "WRITE_CONFIG"]
    },
    {
      "id": "zsh",
      "displayName": "Zsh",
      "description": "管理 .zshrc 中由 UserHome 所有的别名与环境配置块。",
      "iconKey": "zsh",
      "detectionRules": [
        { "kind": "EXECUTABLE", "value": "zsh" },
        { "kind": "BREW_FORMULA", "value": "zsh" },
        { "kind": "HOME_PATH", "value": "~/.zshrc" }
      ],
      "executables": ["zsh"],
      "brewFormulae": ["zsh"],
      "brewCasks": [],
      "configDocuments": [
        {
          "configId": "zshrc",
          "pathTemplate": "~/.zshrc",
          "format": "SHELL",
          "sensitivity": "SENSITIVE",
          "adapterId": "zsh-managed-block",
          "validatorId": "zsh",
          "maxSizeBytes": 524288,
          "writePolicy": "MANAGED_BLOCK"
        }
      ],
      "services": [],
      "capabilities": ["DETECT", "READ_CONFIG", "WRITE_CONFIG"]
    },
    {
      "id": "npm",
      "displayName": "npm",
      "description": "管理用户级 npm 设置，并始终屏蔽认证信息。",
      "iconKey": "npm",
      "detectionRules": [
        { "kind": "EXECUTABLE", "value": "npm" },
        { "kind": "HOME_PATH", "value": "~/.npmrc" }
      ],
      "executables": ["npm"],
      "brewFormulae": ["node"],
      "brewCasks": [],
      "configDocuments": [
        {
          "configId": "npm-user-config",
          "pathTemplate": "~/.npmrc",
          "format": "INI",
          "sensitivity": "SECRET",
          "adapterId": "npmrc",
          "validatorId": "npmrc",
          "maxSizeBytes": 262144,
          "writePolicy": "STRUCTURED_AND_RAW"
        }
      ],
      "services": [],
      "capabilities": ["DETECT", "READ_CONFIG", "WRITE_CONFIG"]
    }
  ]
}
